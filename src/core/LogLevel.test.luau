local expect = require("@std/test/assert")
local test = require("@std/test")

local LogLevel = require("@root/core/LogLevel")

test.suite("LogLevel.shouldLog", function(suite)
	suite:case("emits records at or above the minimum level", function()
		expect.that(LogLevel.shouldLog("info", "info"))
		expect.that(LogLevel.shouldLog("info", "warn"))
		expect.that(LogLevel.shouldLog("info", "err"))
		expect.that(LogLevel.shouldLog("trace", "trace"))
	end)

	suite:case("filters records below the minimum level", function()
		expect.never.that(LogLevel.shouldLog("info", "debug"))
		expect.never.that(LogLevel.shouldLog("info", "trace"))
		expect.never.that(LogLevel.shouldLog("err", "warn"))
	end)

	suite:case("orders all five levels strictly", function()
		expect.that(LogLevel.ORDER.trace < LogLevel.ORDER.debug)
		expect.that(LogLevel.ORDER.debug < LogLevel.ORDER.info)
		expect.that(LogLevel.ORDER.info < LogLevel.ORDER.warn)
		expect.that(LogLevel.ORDER.warn < LogLevel.ORDER.err)
	end)
end)

test.suite("LogLevel.coerce", function(suite)
	suite:case("passes valid levels through", function()
		expect.eq(LogLevel.coerce("info"), "info")
		expect.eq(LogLevel.coerce("trace"), "trace")
		expect.eq(LogLevel.coerce("err"), "err")
	end)

	suite:case("is case-insensitive", function()
		expect.eq(LogLevel.coerce("INFO"), "info")
		expect.eq(LogLevel.coerce("Debug"), "debug")
	end)

	suite:case("maps common aliases", function()
		expect.eq(LogLevel.coerce("error"), "err")
		expect.eq(LogLevel.coerce("warning"), "warn")
	end)

	suite:case("rejects unknown strings and nil", function()
		expect.eq(LogLevel.coerce("loud"), nil)
		expect.eq(LogLevel.coerce(""), nil)
		expect.eq(LogLevel.coerce(nil), nil)
	end)
end)
