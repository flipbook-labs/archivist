local expect = require("@std/test/assert")
local test = require("@std/test")

local LogLevel = require("@root/core/LogLevel")

test.suite("LogLevel.shouldLog", function(suite)
	suite:case("emits records at or above the minimum level", function()
		expect.that(LogLevel.shouldLog(LogLevel.Info, LogLevel.Info))
		expect.that(LogLevel.shouldLog(LogLevel.Info, LogLevel.Warn))
		expect.that(LogLevel.shouldLog(LogLevel.Info, LogLevel.Err))
		expect.that(LogLevel.shouldLog(LogLevel.Trace, LogLevel.Trace))
	end)

	suite:case("filters records below the minimum level", function()
		expect.never.that(LogLevel.shouldLog(LogLevel.Info, LogLevel.Debug))
		expect.never.that(LogLevel.shouldLog(LogLevel.Info, LogLevel.Trace))
		expect.never.that(LogLevel.shouldLog(LogLevel.Err, LogLevel.Warn))
	end)

	suite:case("orders all five levels strictly", function()
		expect.that(LogLevel.ORDER[LogLevel.Trace] < LogLevel.ORDER[LogLevel.Debug])
		expect.that(LogLevel.ORDER[LogLevel.Debug] < LogLevel.ORDER[LogLevel.Info])
		expect.that(LogLevel.ORDER[LogLevel.Info] < LogLevel.ORDER[LogLevel.Warn])
		expect.that(LogLevel.ORDER[LogLevel.Warn] < LogLevel.ORDER[LogLevel.Err])
	end)
end)

test.suite("LogLevel.coerce", function(suite)
	suite:case("passes valid levels through", function()
		expect.eq(LogLevel.coerce("info"), LogLevel.Info)
		expect.eq(LogLevel.coerce("trace"), LogLevel.Trace)
		expect.eq(LogLevel.coerce("err"), LogLevel.Err)
	end)

	suite:case("is case-insensitive", function()
		expect.eq(LogLevel.coerce("INFO"), LogLevel.Info)
		expect.eq(LogLevel.coerce("Debug"), LogLevel.Debug)
	end)

	suite:case("maps common aliases", function()
		expect.eq(LogLevel.coerce("error"), LogLevel.Err)
		expect.eq(LogLevel.coerce("warning"), LogLevel.Warn)
	end)

	suite:case("rejects unknown strings and nil", function()
		expect.eq(LogLevel.coerce("loud"), nil)
		expect.eq(LogLevel.coerce(""), nil)
		expect.eq(LogLevel.coerce(nil), nil)
	end)
end)
